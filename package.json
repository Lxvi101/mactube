{
  "name": "mactube",
  "private": true,
  "version": "0.1.0",
  "description": "A private, macOS-first video, playlist, and audio downloader.",
  "license": "MIT",
  "author": "Lxvi101",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lxvi101/mactube.git"
  },
  "bugs": {
    "url": "https://github.com/Lxvi101/mactube/issues"
  },
  "homepage": "https://github.com/Lxvi101/mactube#readme",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "format": "prettier --write src extension *.json *.ts *.md",
    "format:check": "prettier --check src extension *.json *.ts *.md",
    "preview": "vite preview",
    "tauri": "tauri",
    "video:audio": "./scripts/generate-trailer-score.sh",
    "prevideo:studio": "pnpm video:audio",
    "video:studio": "remotion studio remotion/index.ts",
    "prevideo:render": "pnpm video:audio",
    "video:render": "remotion render remotion/index.ts MacTubeLaunch out/mactube-x-launch.mp4 --codec=h264 --crf=16",
    "prevideo:poster": "pnpm video:audio",
    "video:poster": "remotion still remotion/index.ts MacTubeLaunch out/mactube-x-launch-poster.png --frame=570"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.515",
    "@tauri-apps/cli": "^2.7.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "prettier": "^3.9.6",
    "remotion": "^4.0.515",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
